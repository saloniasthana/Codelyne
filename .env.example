# Free contact form: get an access key at https://web3forms.com (no backend needed).
# Without it, the form falls back to opening the visitor's email app.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Optional: Cloudflare Web Analytics beacon token (free, privacy-friendly).
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Discovery-call booking (/book-a-call): your public Calendly event link, e.g.
# https://calendly.com/codelyne/discovery-call  (connect Google Calendar + Google Meet in Calendly,
# and add one invitee question first — it receives the project details from the form).
# Without it, the booking page shows "Booking calendar not configured yet".
NEXT_PUBLIC_CALENDLY_URL=
